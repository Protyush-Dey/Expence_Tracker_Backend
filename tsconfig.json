{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2020",
    "moduleResolution": "Node16",

    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "resolveJsonModule": true,
    "sourceMap": true,

    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}